{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/asset-manifest.schema.json",
  "title": "Verified Runtime Asset Manifest",
  "type": "object",
  "required": ["schemaVersion", "atlases", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "atlases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["image", "width", "height"],
        "properties": {
          "image": {"type": "string", "minLength": 1},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["atlasFrame", "image", "audio", "font", "shader", "data"]},
          "atlas": {"type": "string"},
          "frame": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "w": {"type": "integer", "minimum": 1},
              "h": {"type": "integer", "minimum": 1}
            }
          },
          "pivot": {
            "type": "object",
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          },
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    }
  },
  "additionalProperties": true
}
